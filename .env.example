# Example environment variables for Panorama Assist

# Gemini API (Google AI Studio)
VITE_GEMINI_API_KEY=

# Frontend -> API URL (optional)
VITE_API_URL=http://localhost:5000

# PostgreSQL connection (used by panorama-backend)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example (default values from setup-postgres.sh):
DATABASE_URL=postgresql://panorama_user:panorama2026@localhost:5432/panorama_bukavu?schema=public

# Note: do NOT commit real secrets. Copy this file to .env or .env.local and fill values.
